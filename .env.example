# Supabase Configuration (Optional for local demo mode; required for cloud persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional direct Gemini API key for client-side Vision flyer extraction in local mode
VITE_GEMINI_API_KEY=

# Shared Crew Passcode for Trusted Contributor Mode (Defaults to 1922 — North Wildwood / Anglesea heritage)
VITE_CREW_PIN=1922
